// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Thread {
  id        String    @id @default(cuid())
  userId    String    // Clerk User ID of the client
  subject   String
  status    String    @default("OPEN") // OPEN, IN_PROGRESS, AWAITING_REPLY, CLOSED
  budget    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String   // Clerk User ID or 'ADMIN'
  content   String
  createdAt DateTime @default(now())
}

model Product {
  id                    String      @id @default(cuid())
  name                  String
  description           String?
  price                 Float
  lemonSqueezyVariantId String?     @unique
  status                String      @default("ACTIVE") // ACTIVE, DRAFT, HIDDEN
  viewCount             Int         @default(0) // Custom analytics
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  orderItems            OrderItem[]
}

model Order {
  id                String      @id @default(cuid())
  lemonSqueezyId    String      @unique
  customerId        String      // Clerk User ID or email
  customerEmail     String?
  totalAmount       Float
  discountApplied   Float       @default(0)
  status            String      @default("PAID") // PENDING, PAID, REFUNDED
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  orderItems        OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  price       Float
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
}
